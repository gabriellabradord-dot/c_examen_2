@page
@model Ejercicio07Model
@{ ViewData["Title"] = "Ejercicio 07 - Comparación de vectores"; }
<section class="exercise-page">
    <header class="exercise-heading">
        <p class="eyebrow">Práctica 07 · 100 posiciones</p>
        <h1>Comparar dos vectores</h1>
        <p class="exercise-copy">Dos vectores son iguales cuando contienen el mismo valor en cada posición.</p>
    </header>
    <partial name="_ExerciseError" model="Model.Error" />
    <form method="post" class="exercise-form">
        <div class="vector-input-grid">
            <div><label asp-for="EntradaM" class="form-label">Vector M</label><textarea asp-for="EntradaM" class="form-control" rows="3" placeholder="100 números"></textarea><span class="form-hint">Exactamente 100 valores; vacío genera un vector.</span></div>
            <div><label asp-for="EntradaN" class="form-label">Vector N</label><textarea asp-for="EntradaN" class="form-control" rows="3" placeholder="100 números"></textarea><span class="form-hint">Exactamente 100 valores; vacío copia M.</span></div>
        </div>
        <div class="form-actions">
            <button class="btn btn-dark" asp-page-handler="Calcular">Comparar</button>
            <button class="btn btn-outline-secondary" asp-page-handler="GenerarIguales">Generar iguales</button>
            <button class="btn btn-outline-secondary" asp-page-handler="GenerarDiferentes">Generar diferentes</button>
        </div>
    </form>
    @if (Model.Mostrar)
    {
        <section class="exercise-results" aria-labelledby="result-title">
            <h2 id="result-title">Resultado</h2>
            <div class="result-banner @(Model.Iguales ? "" : "is-negative")">@Model.Mensaje</div>
            @if (!Model.Iguales)
            {
                <p class="mt-3">Primera diferencia: posición @Model.PrimeraDiferencia (M = @Model.ValorM, N = @Model.ValorN).</p>
            }
        </section>
    }
    <a class="back-link" asp-page="/Index">← Todas las prácticas</a>
</section>
