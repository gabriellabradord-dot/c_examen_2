<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | Laboratorio de vectores</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/c_examen_2.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg" aria-label="Navegación principal">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index"><span class="brand-mark">V</span><span>Laboratorio de vectores</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation"
                        aria-expanded="false" aria-label="Abrir navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index">Inicio</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Ejercicios</a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-page="/Ejercicio01">01 · Promedio</a></li>
                                <li><a class="dropdown-item" asp-page="/Ejercicio02">02 · Suma de vectores</a></li>
                                <li><a class="dropdown-item" asp-page="/Ejercicio03">03 · Valor mayor</a></li>
                                <li><a class="dropdown-item" asp-page="/Ejercicio04">04 · Cuadrados</a></li>
                                <li><a class="dropdown-item" asp-page="/Ejercicio05">05 · Conteo y sumas</a></li>
                                <li><a class="dropdown-item" asp-page="/Ejercicio06">06 · Inversión</a></li>
                                <li><a class="dropdown-item" asp-page="/Ejercicio07">07 · Comparación</a></li>
                                <li><a class="dropdown-item" asp-page="/Ejercicio08">08 · Orden ascendente</a></li>
                                <li><a class="dropdown-item" asp-page="/Ejercicio09">09 · Búsqueda secuencial</a></li>
                                <li><a class="dropdown-item" asp-page="/Ejercicio10">10 · Producto invertido</a></li>
                                <li><a class="dropdown-item" asp-page="/Ejercicio11">11 · Fibonacci</a></li>
                            </ul>
                        </li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Privacy">Privacidad</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="container site-main" id="main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-content">
            <span>Laboratorio de vectores · C# y Razor Pages</span>
            <a asp-page="/Privacy">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
