@page
@model MyApp.Namespace.vector_hoyModel
@{
    ViewData["Title"] = "Matriz de Personas";
}

<div class="container mt-4">
    <h3>Llenar una matriz con nombres</h3>

    <table class="table table-bordered mt-3">
        @for (int i = 0; i < Model.personas.GetLength(0); i++)
        {
            <tr>
                @for (int j = 0; j < Model.personas.GetLength(1); j++)
                {
                    <td>@Model.personas[i, j]</td>
                }
            </tr>
        }
    </table>
</div>
