@page
@model Ejercicio03Model
@{
    ViewData["Title"] = "Ejercicio 03 - Elemento mayor (20)";
}
<section class="exercise-page">
    <header class="exercise-heading">
        <p class="eyebrow">Práctica 03 · 20 posiciones</p>
        <h1>Encontrar el valor mayor</h1>
        <p class="exercise-copy">Recorre el vector y muestra el valor máximo junto con su posición. Si se repite, se indica la primera aparición.</p>
    </header>
    <partial name="_ExerciseError" model="Model.Error" />
    <form method="post" class="exercise-form">
        <label asp-for="Entrada" class="form-label">Valores del vector</label>
        <textarea asp-for="Entrada" class="form-control" rows="3" placeholder="20 números"></textarea>
        <span class="form-hint">Exactamente 20 valores; vacío genera un ejemplo.</span>
        <div class="form-actions">
            <button class="btn btn-dark" asp-page-handler="Calcular">Encontrar mayor</button>
            <button class="btn btn-outline-secondary" asp-page-handler="Generar">Generar ejemplo</button>
        </div>
    </form>
    @if (Model.Mostrar)
    {
        <section class="exercise-results" aria-labelledby="result-title">
            <h2 id="result-title">Resultado</h2>
            <div class="result-banner">El mayor es <strong>@Model.Mayor.ToString("0.##")</strong>, en la posición <strong>@Model.Posicion</strong> (índice @Model.Indice).</div>
            <h3 class="mt-4">Vector</h3>
            <div class="data-strip">@string.Join(", ", Model.Vector.Select(x => x.ToString("0.##")))</div>
        </section>
    }
    <a class="back-link" asp-page="/Index">← Todas las prácticas</a>
</section>
